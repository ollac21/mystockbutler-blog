n tk__go\" data-tk data-cta=\"page\" rel=\"nofollow\" href=\"https://app.mystockbutler.com/signup?ticker=TTE.PA&amp;src=seo-zonebourse-fr\">Ouvrir son rapport gratuit</a></form>\n<p class=\"free\">Un nouveau compte reçoit gratuitement le rapport prêt d'une société. Sans carte bancaire.</p>\n<p class=\"rcard__v\"><button type=\"button\" class=\"rlink\" data-open-viewer>Voir à quoi ressemble un rapport <span aria-hidden=\"true\">&#9656;</span></button></p>\n</div></aside>\n</div>",
 "bar": "<div class=\"mbar\" id=\"mbar\" role=\"region\" aria-label=\"Un rapport gratuit\"><div class=\"mbar__in\"><div class=\"mbar__row\"><form class=\"tk \" onsubmit=\"return false\" aria-label=\"Ouvrir le rapport d'une société\"><label class=\"sr\" for=\"tk-bar\">Symbole boursier</label><input id=\"tk-bar\" type=\"text\" inputmode=\"text\" autocomplete=\"off\" autocapitalize=\"characters\" spellcheck=\"false\" maxlength=\"12\" placeholder=\"Symbole, ex. TTE.PA\" aria-label=\"Symbole boursier\"><a class=\"btn tk__go\" data-tk data-cta=\"page\" rel=\"nofollow\" href=\"https://app.mystockbutler.com/signup?ticker=TTE.PA&amp;src=seo-zonebourse-fr\">Rapport gratuit</a></form><button class=\"mbar__x\" type=\"button\" data-bar-close aria-label=\"Fermer ce bandeau\">&times;</button></div><p class=\"free\">Un nouveau compte reçoit gratuitement le rapport prêt d'une société. Sans carte bancaire.</p></div></div>\n<script>\ndocument.documentElement.classList.add('js');\n(function(){\n  var d=document, w=window;\n  function fit(){}\n  /* the ticker boxes: one value everywhere, the button's link is rebuilt on every key */\n  var forms=[].slice.call(d.querySelectorAll('.tk'));\n  function url(t){ return 'https://app.mystockbutler.com/signup?ticker='+encodeURIComponent(t)+'&src=seo-zonebourse-fr'; }\n  function sync(val,from){ var t=(val||'').trim().toUpperCase().replace(/[^A-Z0-9.\\-]/g,''); forms.forEach(function(f){ var i=f.querySelector('input'), a=f.querySelector('[data-tk]'); if(f!==from) i.value=val; a.href=url(t||'TTE.PA'); }); }\n  forms.forEach(function(f){ var i=f.querySelector('input'), a=f.querySelector('[data-tk]');\n    i.addEventListener('input',function(){ sync(i.value,f); });\n    i.addEventListener('keydown',function(e){ if(e.key==='Enter'){ e.preventDefault(); sync(i.value,f); a.click(); } });\n    a.addEventListener('click',function(){ sync(i.value,f); }); });\n  /* the left nav: the current section is highlighted; a thin line shows how far down the page you are */\n  var secs=[].slice.call(d.querySelectorAll('[data-sec]')), links=[].slice.call(d.querySelectorAll('[data-nav]')), cur=null;\n  var pill=d.querySelector('.mnav__t');\n  function setCur(id){ if(id===cur) return; cur=id;\n    links.forEach(function(a){ var on=a.getAttribute('data-nav')===id; a.classList.toggle('is-cur',on); if(on) a.setAttribute('aria-current','true'); else a.removeAttribute('aria-current'); });\n    var s=d.getElementById(id); if(pill&&s){ pill.textContent=s.getAttribute('data-pill')||''; } if(s&&w.__rail) w.__rail(s);\n    [].slice.call(d.querySelectorAll('.d-side .sub')).forEach(function(u){ var p=u.previousElementSibling, a=p&&p.querySelector('[data-nav]'); u.classList.toggle('on',!!a&&a.getAttribute('data-nav')===id); }); }\n  /* IntersectionObserver wakes the check; the current section is the last one whose top has passed 30% of the screen */\n  function pick(){ var best=secs[0]; secs.forEach(function(s){ if(s.getBoundingClientRect().top <= w.innerHeight*0.3) best=s; }); if(best) setCur(best.id); }\n  if('IntersectionObserver' in w){\n    var io=new IntersectionObserver(function(){ pick(); },{rootMargin:'-22% 0px -68% 0px',threshold:[0,1]});\n    secs.forEach(function(s){ io.observe(s); });\n  }\n  if(secs.length) setCur(secs[0].id);\n  function atTop(){ pick(); }\n  /* the phone bar: appears only after the first example has been scrolled past, closes with x, never over the offer */\n  var bars=[].slice.call(d.querySelectorAll('.d-side__track i, .mnav__bar i')), mbar=d.getElementById('mbar'), offer=d.getElementById('offer'), after=d.querySelector('[data-bar-after]'), passed=false, dismissed=false;\n  if(after&&'IntersectionObserver' in w){\n    new IntersectionObserver(function(es){ es.forEach(function(en){ passed = !en.isIntersecting && en.boundingClientRect.bottom < 0; showBar(); }); },{threshold:[0]}).observe(after);\n  }\n  function showBar(){ if(!mbar) return; var atOffer=offer&&offer.getBoundingClientRect().top < w.innerHeight*0.85;\n    var on=passed&&!dismissed&&!atOffer; mbar.classList.toggle('on',on); d.body.classList.toggle('has-bar',on); }\n  var bx=d.querySelector('[data-bar-close]'); if(bx) bx.addEventListener('click',function(){ dismissed=true; showBar(); });\n  function onScroll(){ atTop(); var h=d.documentElement.scrollHeight-w.innerHeight, p=h>0?Math.min(1,Math.max(0,w.scrollY/h)):0;\n    bars.forEach(function(b){ b.style.setProperty('--p',(p*100).toFixed(1)+'%'); });\n    if(after){ passed = after.getBoundingClientRect().bottom < 0; } showBar(); }\n  w.addEventListener('scroll',onScroll,{passive:true}); onScroll();\n  /* the term popovers: hover or focus on desktop, tap on a phone; a button with aria-expanded and a panel of two sentences */\n  var terms=[].slice.call(d.querySelectorAll('.term')), canHover=w.matchMedia&&w.matchMedia('(hover:hover)').matches;\n  function closeT(t){ var p=t.querySelector('.term__p'), b=t.querySelector('.term__b'); p.hidden=true; p.style.left=''; b.setAttribute('aria-expanded','false'); }\n  function openT(t){ terms.forEach(function(o){ if(o!==t) closeT(o); }); var p=t.querySelector('.term__p'), b=t.querySelector('.term__b'); p.hidden=false; p.style.left='0px'; b.setAttribute('aria-expanded','true');\n    var r=p.getBoundingClientRect(), vw=d.documentElement.clientWidth, sh=0; if(r.right>vw-12) sh=vw-12-r.right; if(r.left+sh<12) sh=12-r.left; p.style.left=sh+'px'; }\n  terms.forEach(function(t){ var b=t.querySelector('.term__b'), tm=null;\n    b.addEventListener('click',function(e){ e.stopPropagation(); if(b.getAttribute('aria-expanded')==='true'&&!(canHover&&!t.__clicked)){ closeT(t); t.__clicked=false; } else { openT(t); t.__clicked=true; } });\n    if(canHover){ t.addEventListener('mouseenter',function(){ clearTimeout(tm); if(b.getAttribute('aria-expanded')!=='true'){ t.__clicked=false; openT(t); } });\n      t.addEventListener('mouseleave',function(){ clearTimeout(tm); tm=setTimeout(function(){ if(!t.__clicked) closeT(t); },160); }); }\n    t.addEventListener('focusout',function(e){ if(!t.contains(e.relatedTarget)) closeT(t); }); });\n  d.addEventListener('click',function(e){ if(!e.target.closest('.term')) terms.forEach(closeT); });\n  d.addEventListener('keydown',function(e){ if(e.key==='Escape') terms.forEach(function(t){ if(!t.querySelector('.term__p').hidden){ closeT(t); t.querySelector('.term__b').focus(); } }); });\n\n  /* the phone step pill */\n  var pl=d.querySelector('.mnav__pill'), ml=d.getElementById('mnav-l');\n  if(pl&&ml){ pl.addEventListener('click',function(){ var o=ml.hidden; ml.hidden=!o; pl.setAttribute('aria-expanded',o); });\n    ml.addEventListener('click',function(e){ if(e.target.closest('a')){ ml.hidden=true; pl.setAttribute('aria-expanded','false'); } });\n    d.addEventListener('keydown',function(e){ if(e.key==='Escape'&&!ml.hidden){ ml.hidden=true; pl.setAttribute('aria-expanded','false'); } }); }\n  /* the report viewer */\n  var vw=d.getElementById('viewer');\n  if(vw){ var opener=null;\n    function openV(b){ opener=b; vw.hidden=false; d.body.classList.add('locked'); var win=vw.querySelector('.viewer__win'); if(win) win.focus({preventScroll:true}); }\n    function shutV(){ if(vw.hidden) return; vw.hidden=true; d.body.classList.remove('locked'); if(opener) opener.focus({preventScroll:true}); }\n    d.querySelectorAll('[data-open-viewer]').forEach(function(b){ b.addEventListener('click',function(e){ e.preventDefault(); openV(b); }); });\n    vw.querySelectorAll('[data-close-viewer]').forEach(function(b){ b.addEventListener('click',shutV); });\n    vw.addEventListener('click',function(e){ if(e.target===vw) shutV(); });\n    d.addEventListener('keydown',function(e){ if(e.key==='Escape') shutV(); });\n    vw.querySelectorAll('[data-goto]').forEach(function(b){ b.addEventListener('click',function(){ var t=d.getElementById(b.getAttribute('data-goto')); if(t) t.scrollIntoView({block:'start'}); }); }); }\n\n  d.addEventListener('click',function(e){ var b=e.target.closest('[data-lock]'); if(!b) return; var l=d.getElementById('lockbox'); if(l) l.scrollIntoView({block:'center'}); });\n  /* the right card stays hidden while the two-ways box at the top is in view */\n  var topBox=d.querySelector('.hero .offer--two'), rcard=d.querySelector('.rcard');\n  if(topBox&&rcard&&'IntersectionObserver' in w){ rcard.classList.add('is-off'); new IntersectionObserver(function(es){ es.forEach(function(en){ rcard.classList.toggle('is-off',en.isIntersecting); }); },{threshold:0}).observe(topBox); }\n  /* the right card: its headline and line follow the section in view; without JS the generic card stays */\n  var rh=d.querySelector('.rcard__h'), rl=d.querySelector('.rcard__s');\n  w.__rail=function(s){ if(!rh||!rl) return; var a=s.getAttribute('data-rail-h'), b=s.getAttribute('data-rail-l'); if(a){ rh.textContent=a; rl.textContent=b||''; } };\n})();\n</script>",
